DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 本機未設定 DATABASE_URL 時固定使用 backend/db.sqlite3；Docker Compose 會注入 PostgreSQL URL。
POSTGRES_USER=argus
POSTGRES_PASSWORD=replace-with-a-local-db-password
POSTGRES_DB=argus
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true
ARGUS_AUTO_QUEUE_SCANS=true
# 金流：disabled（預設，購點／訂閱 API 回 503）／ecpay_test（綠界測試環境，不扣款）／ecpay（正式扣款）。
# 結帳與定期定額網址由模式自動決定（不用再設 ECPAY_CHECKOUT_URL）；ecpay 模式不接受綠界公開測試商店代號。
ARGUS_PAYMENT_MODE=disabled
# 綠界廠商後台「廠商專區 → 系統開發管理 → 系統介接設定」取得；機密值只放 .env／K8s Secret
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 綠界只會通知公開 HTTPS（443、合法網域、200 字元內）網址
ECPAY_RETURN_URL=
ECPAY_CLIENT_BACK_URL=
# 選填：訂閱第 2 期起每月扣款結果通知；留空＝ReturnURL 同網域的 /api/billing/ecpay/period-callback/
ECPAY_PERIOD_RETURN_URL=
PASSWORD_RESET_TOKEN_PEPPER=replace-with-a-long-independent-random-secret
# 只有這些代理網段可提供 X-Forwarded-For；未設定時一律使用 REMOTE_ADDR。
TRUSTED_PROXY_CIDRS=
# 只有反向代理會覆寫 X-Forwarded-Proto，且應用程式不可被外網直連時才能開啟。
TRUST_PROXY_SSL_HEADER=false
# Production 建議指向會在 DNS 解析後拒絕 private/link-local/metadata 的無認證受控 proxy。
# URL 必須是 http(s)://host:port，不接受 credential、path、query 或 fragment。
ARGUS_EGRESS_PROXY_URL=
PLAYWRIGHT_BROWSERS_PATH=.ms-playwright
# 使用者上傳圖片預設存在本機；S3-compatible（AWS S3 / R2 / MinIO）設定見使用說明。
ARGUS_MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
ARGUS_MEDIA_URL=/media/
# 切換為 storages.backends.s3.S3Storage 時才需要以下設定；金鑰只放 .env / Secret。
ARGUS_MEDIA_BUCKET=
ARGUS_MEDIA_ENDPOINT_URL=
ARGUS_MEDIA_REGION=
ARGUS_MEDIA_CUSTOM_DOMAIN=
ARGUS_MEDIA_ADDRESSING_STYLE=auto
ARGUS_MEDIA_SIGNED_URLS=true
ARGUS_MEDIA_URL_EXPIRE_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-local-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME=60

# 注意：AI provider/model 由程式碼 hardcode（apps/agent/providers.py）
# AI_PROVIDER / AI_MODEL env 暫時不被讀取（過去殭屍配置，待後續整合）
ARGUS_AGENT_ENABLED=false
# AI 掃描解讀（掃描完成後由 AI 寫整體診斷並複核高風險問題；沿用上方 Agent 的 provider 金鑰，每次掃描花 token）
ARGUS_AI_INSIGHT_ENABLED=false
ARGUS_AGENT_MAX_STEPS=20
ARGUS_AGENT_MAX_TOKENS=60000
# 擬真使用者 UX 測試的 token 上限（單一 session，與資安各角色分開）
ARGUS_AGENT_UX_MAX_TOKENS=120000
ARGUS_AGENT_STEP_TIMEOUT=30

# MCP 接入（會員以 Claude Code／Codex 等本地 AI 工具使用 Argus；限有效訂閱）
# 額度只計工具呼叫次數；PLAN_QUOTAS 格式「方案代碼:次數」逗號分隔
ARGUS_MCP_ENABLED=true
ARGUS_MCP_DEFAULT_MONTHLY_CALLS=300
ARGUS_MCP_PLAN_QUOTAS=sub-lite:300,sub-pro:1500,sub-team:6000
ARGUS_MCP_MAX_KEYS=5
ARGUS_MCP_RATE_PER_MINUTE=60
ARGUS_MCP_REPORT_LINK_TTL=900
# 反向代理沒轉送 https 時，固定會員頁顯示的端點與報告連結網址（空＝依請求判斷）
ARGUS_MCP_PUBLIC_BASE_URL=

# 本機／隔離 demo 私網目標旁路（僅 DEBUG 生效；非 DEBUG 開啟會觸發 scans.E002）
# 開啟後可掃 Docker 網路內目標（如 http://juice-shop:3000），見 docker-compose.juice.yml
ARGUS_ALLOW_PRIVATE_TARGETS=false
# Nuclei 硬逾時（秒）；KEV 模板集在 1 RPS 下約 630 秒，逾時保留已得結果並標為部分完成
ARGUS_NUCLEI_TIMEOUT=660
# 掃描流量出口 IP（逗號分隔，可寫 CIDR），公布在公開頁 /scanner 供目標網站放行或封鎖；
# 沒有固定出口就留空（頁面改請對方以 User-Agent 辨識）。格式錯誤由 manage.py check 擋下（scans.E003）
ARGUS_SCANNER_EGRESS_IPS=
# Nuclei 模板目錄：Docker image 內固定為 /opt/nuclei-templates（建置時鎖版本並驗證）；
# 本機直接執行 nuclei 時改成自己下載的同版本模板目錄
# ARGUS_NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates

# Kali SQLmap 執行後端預設停用；runner image 正式啟用時必須使用 repository@sha256 digest。
ARGUS_KALI_ENABLED=false
ARGUS_KALI_BACKEND=disabled
ARGUS_KALI_CONTAINER=argus-kali-1
ARGUS_KALI_NAMESPACE=argus-kali
ARGUS_KALI_RUNNER_IMAGE=
ARGUS_KALI_SQLMAP_VERSION=1.10
ARGUS_KALI_TIMEOUT=120
ARGUS_KALI_REDIS_URL=redis://localhost:6379/0

# Google OAuth Client ID（一般使用者透過 Google 帳號登入時使用）
# 取得方式：Google Cloud Console > APIs & Services > Credentials > 建立 OAuth 用戶端 ID（Web application）
# 必須將 http://localhost:5173 與 http://localhost 加入「已授權的 JavaScript 來源」
# Backend 用於驗證 ID Token，Frontend 透過 Vite envPrefix 讀取同一個變數
GOOGLE_OAUTH_CLIENT_ID=

# Google Search Console 串接（SEO 分析頁「搜尋關鍵字」）：與登入共用上方 OAuth 用戶端，另需 client secret；
# 兩者都有值才啟用。Google Cloud Console 需要：
#   1. 啟用「Google Search Console API」
#   2. OAuth 同意畫面加入 scope https://www.googleapis.com/auth/webmasters.readonly
#   3. OAuth 用戶端「已授權的重新導向 URI」加入每個對外網域的 <網址>/api/gsc/callback/
#      （本機例：http://127.0.0.1:8000/api/gsc/callback/）
GOOGLE_OAUTH_CLIENT_SECRET=
# 選填：固定 callback 網址。只在使用者一律從同一個網域登入時才設；空值＝用目前網域組成（建議）
ARGUS_GSC_REDIRECT_URI=
# 選填：refresh token 加密金鑰（Fernet key；產生：uv run python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"）。空值＝由 DJANGO_SECRET_KEY 推導（輪替後需重新連接）
ARGUS_GSC_TOKEN_KEY=
# SEO 連結檢查（掃描勾 SEO 時執行）：最多檢查幾個不重複連結、總時間上限（秒）
ARGUS_SEO_LINK_CHECK_LIMIT=150
ARGUS_SEO_LINK_CHECK_SECONDS=120
# axe-core 無障礙檢查（掃描勾 UX 時執行）：開關、每頁逾時（秒）、最多檢查幾頁
ARGUS_AXE_ENABLED=true
ARGUS_AXE_TIMEOUT_SECONDS=15
ARGUS_AXE_MAX_PAGES=50
# 爬蟲每頁等內容穩定（DOM 不再變動）的上限秒數；逾時照樣擷取並記錄
ARGUS_RENDER_READY_MAX_SECONDS=5
# Google PageSpeed Insights（Lighthouse 分數＋CrUX 真實使用者資料；掃描勾 UX 時只測首頁）
# 有金鑰才會執行（沒有金鑰時 Google 匿名配額幾乎都用完）；受測網址會送到 Google 量測。
# 金鑰只放 .env／K8s Secret，不得寫進 log 或 commit。ENABLED 預設＝有金鑰時開啟
ARGUS_PAGESPEED_API_KEY=
# ARGUS_PAGESPEED_ENABLED=true
ARGUS_PAGESPEED_TIMEOUT_SECONDS=90
# 快速檢查頁「網站測速」也會用同一把金鑰（Celery 背景量測＋前端輪詢）；輪詢節流預設 600/hour
# THROTTLE_INSIGHTS_POLL=600/hour
# OWASP ZAP 被動分析（勾資安時；只分析已爬到的流量，對目標零新增請求）。預設關閉，
# 啟用前要先部署 ZAP（docker compose --profile zap，或 k8s/optional/zap-passive.yaml），見 docs/zap-passive.md。
# 金鑰自行產生（例如 openssl rand -hex 24），只放 .env／Secret，不得 commit
ARGUS_ZAP_ENABLED=false
ARGUS_ZAP_API_URL=
ARGUS_ZAP_API_KEY=
ARGUS_ZAP_TIMEOUT_SECONDS=120
# 已知漏洞優先序補強：命中 CVE 時向 EPSS（api.first.org）與 OSV.dev 查被利用機率與修補版本。
# 只送出函式庫名稱、版本與 CVE 編號（不含受測網址）；worker 需能連到這兩個網域，否則原樣保留結果
ARGUS_VULN_INTEL_ENABLED=true
ARGUS_VULN_INTEL_TIMEOUT_SECONDS=10
# PDF 報告轉檔（LibreOffice）逾時秒數
ARGUS_REPORT_PDF_TIMEOUT_SECONDS=120

# Cloudflare Turnstile（註冊、Email 登入、忘記密碼、商業合作洽談的人機驗證）；兩個 key 都有值才啟用。
# 本機測試可用 Cloudflare 官方測試金鑰：site key 1x00000000000000000000AA、
# secret 1x0000000000000000000000000000000AA（DJANGO_DEBUG=true 時才接受測試結果）。
# 正式 site key 0x4AAAAAAFML-ooGY_tDnVk8 的 widget 需登記 localhost／127.0.0.1 才能在本機使用。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# siteverify 回傳的前端 hostname 允許清單（逗號分隔）；本機填 localhost,127.0.0.1
TURNSTILE_HOSTNAMES=

# 以下只填本機實際值；不可提交真正 API Key。
GLM_API_KEY=
MINIMAX_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=GoogleCloud_ApiKey.json

# Katana 補充型資安爬蟲（需安裝 Docker Desktop 並 pull 映像）
# docker pull projectdiscovery/katana:latest
KATANA_DOCKER_IMAGE=projectdiscovery/katana:latest
KATANA_TIMEOUT=90

# 首次 migrate 時自動建立的本機開發超級使用者（僅限本機；正式部署請留空並改用 createsuperuser）
ARGUS_BOOTSTRAP_SUPERUSER_USERNAME=
ARGUS_BOOTSTRAP_SUPERUSER_PASSWORD=

# ─────────────────────────────────────────────
# Email 寄送（購點收據、未來通知）
# ─────────────────────────────────────────────
# Dev 預設用 filebased（寄出的信存到 backend/dev_emails/*.log，可直接打開看）
# 想真實寄信時，把下面 DJANGO_EMAIL_BACKEND 改成 smtp.EmailBackend 並填 SMTP 設定
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# 切到真實 SMTP 時：
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP 範例（強烈推薦，免費、穩定）
# 步驟：
#   1. 你的 Gmail 帳號 → 安全性 → 啟用「兩步驟驗證」（必要）
#   2. 安全性 → 應用程式密碼（App Password） → 選 Mail / Windows Computer → 產生 16 碼密碼
#   3. 把 16 碼貼到 EMAIL_HOST_PASSWORD（**不是**你的 Gmail 登入密碼）
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Argus 系統 <no-reply@argus.local>
